{
  "name": "skill_manage",
  "description": "Create, update or delete skills (procedural memory). `operations` is an ordered array (one edit = list of one), applied atomically: any failure rolls everything back. create (full SKILL.md; before that skill's other ops), patch (old_string/new_string preferred; `content` alone REPLACES the whole file, skill_view first), write_file/remove_file (supporting files), delete (sole op only). Existing skills are edited wherever they live. Skill description: max 60 chars, 'Use when <trigger>. <behavior>.', never the category name. Write lessons, not logs: imperative rule + why, one rule per lesson, no PR numbers/dates/incident narration. Details: skill_view hermes-tools-guide",
  "parameters": {
    "type": "object",
    "properties": {
      "operations": {
        "type": "array",
        "description": "Ordered ops, each naming its skill (lowercase, hyphens/underscores, max 64 chars). Each action has its own shape; another action's text slot is invalid.",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "create"
                  ]
                },
                "content": {
                  "type": "string",
                  "description": "Full SKILL.md (YAML frontmatter + markdown body)."
                },
                "category": {
                  "type": "string",
                  "description": "Optional category subdir (e.g. 'devops')."
                }
              },
              "required": [
                "name",
                "action",
                "content"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "patch"
                  ]
                },
                "old_string": {
                  "type": "string",
                  "description": "Text to find (as in the patch tool)."
                },
                "new_string": {
                  "type": "string",
                  "description": "Replacement; empty string deletes the match."
                },
                "replace_all": {
                  "type": "boolean",
                  "description": "Replace all occurrences (default false)."
                },
                "file_path": {
                  "type": "string",
                  "description": "Optional supporting file; default SKILL.md."
                }
              },
              "required": [
                "name",
                "action",
                "old_string",
                "new_string"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "patch"
                  ]
                },
                "content": {
                  "type": "string",
                  "description": "Full SKILL.md rewrite (REPLACES the whole file; last resort)."
                }
              },
              "required": [
                "name",
                "action",
                "content"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "write_file"
                  ]
                },
                "file_path": {
                  "type": "string",
                  "description": "Path RELATIVE to the skill's directory, e.g. 'references/api.md'; no leading slash, never absolute; first segment references/, templates/, scripts/ or assets/."
                },
                "file_content": {
                  "type": "string",
                  "description": "Full text of the file."
                }
              },
              "required": [
                "name",
                "action",
                "file_path",
                "file_content"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "remove_file"
                  ]
                },
                "file_path": {
                  "type": "string",
                  "description": "Supporting file to remove (same path shape as write_file)."
                }
              },
              "required": [
                "name",
                "action",
                "file_path"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "delete"
                  ]
                },
                "absorbed_into": {
                  "type": "string",
                  "description": "Consolidation only: umbrella skill that absorbed this one (must exist)."
                }
              },
              "required": [
                "name",
                "action"
              ]
            }
          ]
        }
      }
    },
    "required": [
      "operations"
    ]
  }
}
