+ *  this machine, so it asks the backend to open it — a program or script comes
+ *  back shown selected in Explorer instead (a menu never runs one). A backend
+ *  without the route (a real remote Hermes) reports the failure. */
+export async function openFileInDefaultApp(path: string): Promise<void> {
+  try {
+    await hermesApi<{ ok?: boolean }>({
+      body: { url: path },
+      method: 'POST',
+      path: '/api/hermes-rs/open-file'
+    })
+  } catch (error) {
+    notifyError(error, translateNow('errors.genericFailure'))
+  }
+}
