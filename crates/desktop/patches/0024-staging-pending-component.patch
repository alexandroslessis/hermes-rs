+// hermes-rs: the staging area (`GET /api/staging`, `POST /api/staging/<id>/apply|reject`): memory
+// and skill writes the agent made after reading untrusted content wait here for the user.
+import { hermesApi } from '@/api/client'
+
+export type StagedKind = 'memory' | 'skill'
+
+export interface StagedItem {
+  created: number
+  /** Unified-diff text; control and hidden characters arrive spelled out as `<U+XXXX>`. */
+  diff: string
+  /** Why applying it failed, or why it is out of date. */
+  error: null | string
+  id: string
+  kind: StagedKind
+  reason: string
+  session_id: string
+  sources: string[]
+  status: 'pending' | 'stale'
+  summary: string
+}
+
+export async function listStagedItems(): Promise<StagedItem[]> {
+  const response = await hermesApi<{ items?: StagedItem[] }>({ path: '/api/staging' })
+
+  return Array.isArray(response?.items) ? response.items : []
+}
+
+export function applyStagedItem(id: string): Promise<{ message?: string }> {
+  return hermesApi({ body: {}, method: 'POST', path: `/api/staging/${encodeURIComponent(id)}/apply` })
+}
+
+export function rejectStagedItem(id: string): Promise<unknown> {
+  return hermesApi({ body: {}, method: 'POST', path: `/api/staging/${encodeURIComponent(id)}/reject` })
+}
