 /** message.start: arm the session for a new turn, unless it re-sends the current one. */
+/**
+ * hermes-rs: a queued prompt the backend starts on its own (the queue panel's card) has no bubble,
+ * and no event draws one. Its turn's message.start names the admission as `turn_id`: the card
+ * becomes the user's bubble here, under the id a sent prompt's bubble has (`user-<submission>`),
+ * so the turn's receipt binds its stored row and a later transcript read doesn't paint it twice.
+ */
+function showStartedQueuedPrompt({ deps, sessionId }: GatewayEventContext, admissionId: string): void {
+  if (!sessionId || !admissionId) {
+    return
+  }
+
+  const storedId = deps.sessionStateByRuntimeIdRef.current.get(sessionId)?.storedSessionId ?? sessionId
+  const queueKey = resolveComposerSessionKey(storedId, $sessions.get()) ?? storedId
+  const entry = getQueuedPrompts(queueKey).find(candidate => candidate.id === admissionId && candidate.serverStatus)
+
+  if (!entry) {
+    return
+  }
+
+  const messageId = `user-${admissionId}`
+  const text = entry.displayText || entry.text
+
+  deps.updateSessionState(sessionId, state =>
+    state.messages.some(message => message.id === messageId)
+      ? state
+      : { ...state, messages: [...state.messages, { id: messageId, role: 'user', parts: [textPart(text)] }] }
+  )
+  removeQueuedPrompt(queueKey, admissionId)
+}
